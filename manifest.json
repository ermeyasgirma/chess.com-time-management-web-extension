{
  "manifest_version": 3,
  "name": "Chess.com Time Manager",
  "description": "Configurable visual and audio move-time reminders for Chess.com live games.",
  "version": "0.1.0",
  "icons": {
    "16": "public/icons/icon16.png",
    "32": "public/icons/icon32.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "public/icons/icon16.png",
      "32": "public/icons/icon32.png",
      "48": "public/icons/icon48.png",
      "128": "public/icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*"
      ],
      "js": [
        "src/content/chesscom-detector.js",
        "src/content/chesscom-turn-detector.js",
        "src/shared/settings.js",
        "src/shared/move-timer.js",
        "src/shared/warning-controller.js",
        "src/shared/warning-output.js",
        "src/shared/debug-status.js",
        "src/content/warning-overlay.js",
        "src/content/debug-overlay.js",
        "src/content/live-game-content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "public/audio/warning.mp3"
      ],
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*"
      ]
    }
  ]
}
